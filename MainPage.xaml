<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ksiazka.MainPage">

     <Grid Padding="10" RowDefinitions="Auto,*,Auto" ColumnDefinitions="*,*">

        <SearchBar x:Name="test" Placeholder="Szukaj"
                   TextChanged="SearchBar_TextChanged"
                   Grid.Row="0" Grid.ColumnSpan="2"
                   />

        <ListView x:Name="contactsListView" 
                  SelectionMode="Single"
                  Grid.Row="1" Grid.ColumnSpan="2">
            <ListView.ItemTemplate >
                <DataTemplate  >
                    <ViewCell  >
                        <StackLayout  Padding="10" Spacing="5">

                          
                            <FlexLayout  Direction="Row" JustifyContent="Center" AlignItems="Center">
                                <Label x:Name="nameLabel"
                                       Text="{Binding Name}"
                                       FontSize="20"
                                       IsVisible="True"
                                       Margin="0,0,5,0" />
                                <Entry x:Name="nameEdit"
                                       Text="{Binding Name}"
                                       FontSize="20"
                                       IsVisible="False"
                                       WidthRequest="120"
                                       Margin="0,0,10,0" />

                                <Label x:Name="lastNameLabel"
                                       Text="{Binding LastName}"
                                       FontSize="20"
                                       IsVisible="True" />
                                <Entry x:Name="lastNameEdit"
                                       Text="{Binding LastName}"
                                       FontSize="20"
                                       IsVisible="False"
                                       WidthRequest="120" />
                            </FlexLayout>


                            <FlexLayout Direction="Row" JustifyContent="Center" AlignItems="Center" Margin="0,25,0,5">
                                <Label x:Name="phoneNumLabel"
                                       Text="{Binding PhoneNumber}"
                                       FontSize="15"
                                       IsVisible="True" />
                                <Entry x:Name="phoneNumEdit"
                                       Text="{Binding PhoneNumber}"
                                       FontSize="15"
                                       IsVisible="False"
                                       WidthRequest="200" />
                            </FlexLayout>

                            <FlexLayout JustifyContent="Center"
                                        AlignItems="Center"
                                        Direction="Row"
                                        Wrap="Wrap"
                                        Margin="0,10,0,0">
                                <Button x:Name="editButton"
                                        Text="Edytuj"
                                        Clicked="OnEditClicked"
                                        WidthRequest="100"
                                        Margin="0,0,5,0" />
                                <Button Text="Usuń"
                                           WidthRequest="100"
                                        BackgroundColor="Red"
                                        Clicked="OnDeleteClicked" />
                            </FlexLayout>
                           
                        </StackLayout>
                    </ViewCell>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <Button Text="Dodaj kontakt"
                Background="Green"
                Clicked="OnAddContactClicked"
                Grid.Row="2"
                Grid.ColumnSpan="2"/>
    </Grid>


</ContentPage>
